rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && userRole() == 'ADMIN';
    }

    function isSecurity() {
      return signedIn() && userRole() == 'SECURITY';
    }

    function assignedBuilding() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.buildingId;
    }

    function isSecurityFor(buildingId) {
      return isSecurity() && assignedBuilding() == buildingId;
    }

    function isDeveloper() {
      return signedIn() && userRole() == 'DEVELOPER';
    } 

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || isDeveloper());
      allow create, update, delete: if isAdmin() || isDeveloper();
    }

    match /buildings/{buildingId} {
      allow read: if true;
      allow create, delete: if isAdmin() || isDeveloper();
      allow update: if isAdmin() || isDeveloper() || (
        isSecurityFor(buildingId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parking', 'updatedAt'])
      );

      match /dailyParking/{date} {
        allow read: if signedIn();
        allow create, update: if isAdmin() || isSecurityFor(buildingId) || isDeveloper();
        allow delete: if isAdmin() || isDeveloper();
      }

      match /layouts/{layoutId} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin() || isDeveloper();

        match /status/{statusDocId} {
          allow read: if signedIn();
          allow create, update: if isAdmin() || isDeveloper() || isSecurityFor(buildingId);
          allow delete: if isAdmin() || isDeveloper();
        }
      }
    }

    match /vehicleLogs/{logId} {
      // `resource` is null when the document doesn't exist yet - and
      // createVehicleLog's transaction always reads the doc first (by its
      // deterministic buildingId_date_vehicleNumber id) to enforce "not
      // already logged today" before writing. For a brand-new plate that
      // read is of a non-existent doc, so `resource == null` must be
      // allowed through for Security - there is no buildingId to check
      // against yet. Once the doc exists, the real per-building scoping
      // below still applies to reading it.
      // The Employee dashboard's "where is my vehicle parked" lookup
      // (getActiveLogForVehicle) queries this collection directly - an
      // employee needs to read a log that's about their own vehicle, but
      // never anyone else's. Scoped to logs already carrying their uid as
      // employeeId, set automatically by createVehicleLog's owner match.
      allow read: if isAdmin() || isDeveloper() || (isSecurity() && (resource == null || assignedBuilding() == resource.data.buildingId)) || (signedIn() && resource.data.employeeId == request.auth.uid);
      allow create: if isAdmin() || isDeveloper() || isSecurityFor(request.resource.data.buildingId);
      allow update, delete: if isAdmin() || isDeveloper() || (
        isSecurityFor(resource.data.buildingId) &&
        request.resource.data.buildingId == resource.data.buildingId
      );

      match /audit/{auditId} {
        allow read: if isAdmin() || isDeveloper() || isSecurityFor(get(/databases/$(database)/documents/vehicleLogs/$(logId)).data.buildingId);
        allow create: if isAdmin() || isDeveloper() || isSecurityFor(get(/databases/$(database)/documents/vehicleLogs/$(logId)).data.buildingId);
        allow update, delete: if isAdmin() || isDeveloper();
      }
    }

    match /employeeVehicles/{vehicleId} {
      // Security needs read access to look up a plate against the
      // registered-vehicle directory when logging a gate entry (see
      // vehicleLogService.findVehicleOwner / getVehicleDirectory) - it
      // never writes to this collection.
      allow read: if isAdmin() || isDeveloper() || isSecurity() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || isDeveloper() || (signedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
